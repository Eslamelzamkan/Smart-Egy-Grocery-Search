# Database Configuration (PostgreSQL 18.1 with pgvector and pg_trgm)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/product_ai_training
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=product_ai_training

# Embedding Model (Hugging Face)
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
